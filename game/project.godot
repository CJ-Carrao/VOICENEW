; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LAVOICE"
config/use_custom_user_dir=true
config/custom_user_dir_name="LAVOICE-Lab"
config/description="FPS 1v1 de criatividade por voz: tudo que existe na partida é pedido falando e feito da matéria arrancada do mundo."
run/main_scene="res://scenes/intro/intro.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"
config/windows_native_icon="res://icon.ico"

[audio]

driver/enable_input=true

[autoload]

Lexicon="*res://scripts/autoload/lexicon.gd"
Session="*res://scripts/network/network_session.gd"
Forge="*res://scripts/autoload/forge.gd"
CreationCatalog="*res://scripts/ui/creation_catalog.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_overrides]

text_editor/behavior/indent/type=0
text_editor/behavior/indent/size=4

[editor_plugins]

enabled=PackedStringArray()

[input]

